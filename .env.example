# Firebase Web App config (these values identify your Firebase project/app; they are not Gemini auth keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true only for local App Check debugging after registering the debug token in Firebase Console.
VITE_FIREBASE_APPCHECK_DEBUG=false
